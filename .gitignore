## .NET Core / Visual Studio gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Oo]ut/
out/

# Visual Studio
.vs/
.vscode/
*.swp
*.*~
project.lock.json
project.fragment.lock.json
artifacts/

# Roslyn cache
*.ide/

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# MSBuild Binary and Structured Log
*.binlog

# Coverage / Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# JetBrains tooling
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Files generated by JetBrains Rider
.idea/

# OS files
.DS_Store
Thumbs.db

# Application logs
logs/
*.log

# EF Core
*.dbmdl
*.jfm

# Local secrets
*.pfx
*.cer
secrets.json
appsettings.*.Local.json

# Misc
*.tmp
*.bak
